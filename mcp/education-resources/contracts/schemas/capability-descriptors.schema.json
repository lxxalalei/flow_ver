{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/capability-descriptors.schema.json",
  "title": "Education resource static capability descriptor catalog",
  "description": "A versioned catalog of server-owned static capability declarations. Deployment readiness and candidate resolution are separate facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "catalog_version",
    "registry_version",
    "descriptors"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/capability-descriptors.schema.json"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "capability-descriptor.schema.json"
      }
    }
  }
}
