{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/plan-item.schema.json",
  "title": "Education resource acquisition Plan item",
  "description": "A server-generated item describing the exact inspected Representation and Provider route the user is about to confirm. It contains execution facts, not readiness/eligibility authority credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_id",
    "selected_position",
    "platform",
    "representation_id",
    "planned_scope",
    "planned_strategy",
    "planned_provider",
    "planned_container",
    "estimated_size_bytes",
    "risks"
  ],
  "properties": {
    "resource_id": {
      "$ref": "common.schema.json#/$defs/resource_id"
    },
    "selected_position": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "platform": {
      "$ref": "common.schema.json#/$defs/platform_id"
    },
    "representation_id": {
      "$ref": "common.schema.json#/$defs/representation_id"
    },
    "planned_scope": {
      "$ref": "common.schema.json#/$defs/capability_scope"
    },
    "planned_strategy": {
      "$ref": "common.schema.json#/$defs/capability_strategy"
    },
    "planned_provider": {
      "$ref": "common.schema.json#/$defs/provider_ref"
    },
    "planned_container": {
      "type": "string",
      "enum": ["original", "pdf", "epub", "mp4", "mp3", "m4a", "html", "text"]
    },
    "estimated_size_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "risks": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/risk"
      }
    }
  },
  "$defs": {
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "level": {
          "$ref": "common.schema.json#/$defs/risk_level"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
