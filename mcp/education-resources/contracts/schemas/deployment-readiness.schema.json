{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/deployment-readiness.schema.json",
  "title": "Education resource deployment readiness snapshot",
  "description": "A server-generated snapshot of whether one declared capability is loaded and usable in the current deployment. Readiness never proves candidate availability or user rights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "readiness_snapshot_id",
    "capability_id",
    "descriptor_version",
    "descriptor_digest",
    "snapshot_digest",
    "status",
    "provider",
    "inspector",
    "load_status",
    "dependency_checks",
    "credential_posture",
    "network_policy_status",
    "policy_profile",
    "observed_at",
    "expires_at",
    "fallback_capability_ids"
  ],
  "properties": {
    "capability_id": {
      "$ref": "common.schema.json#/$defs/capability_id"
    },
    "descriptor_version": {
      "$ref": "common.schema.json#/$defs/component_version"
    },
    "descriptor_digest": {
      "$ref": "common.schema.json#/$defs/canonical_digest"
    },
    "snapshot_digest": {
      "$ref": "common.schema.json#/$defs/canonical_digest"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/readiness_status"
    },
    "provider": {
      "$ref": "common.schema.json#/$defs/provider_ref"
    },
    "inspector": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/inspector_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "load_status": {
      "$ref": "common.schema.json#/$defs/load_status"
    },
    "dependency_checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/dependency_check"
      }
    },
    "credential_posture": {
      "type": "string",
      "enum": [
        "none",
        "optional_missing",
        "optional_present",
        "required_present",
        "required_missing",
        "invalid"
      ]
    },
    "network_policy_status": {
      "type": "string",
      "enum": [
        "not_required",
        "allowed",
        "restricted",
        "blocked",
        "unknown"
      ]
    },
    "policy_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "fallback_capability_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/capability_id"
      }
    },
    "checked_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/capability_scope"
      }
    },
    "readiness_snapshot_id": {
      "$ref": "common.schema.json#/$defs/readiness_snapshot_id"
    }
  },
  "$defs": {
    "dependency_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "missing",
            "failed",
            "not_checked"
          ]
        },
        "version": {
          "$ref": "common.schema.json#/$defs/component_version"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "../error-codes.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "retriable": {
          "type": "boolean"
        }
      }
    }
  }
}
