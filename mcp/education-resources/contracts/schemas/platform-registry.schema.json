{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/platform-registry.schema.json",
  "title": "Education resource platform capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registry_version",
    "platforms"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/platform-registry.schema.json"
    },
    "registry_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "platforms": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform"
      }
    }
  },
  "$defs": {
    "platform_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "article",
        "book",
        "document",
        "video",
        "audio",
        "course",
        "dataset",
        "other"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search",
        "browse_creator",
        "inspect",
        "acquire"
      ],
      "properties": {
        "search": {
          "type": "boolean"
        },
        "browse_creator": {
          "type": "boolean"
        },
        "inspect": {
          "type": "boolean"
        },
        "acquire": {
          "type": "boolean"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "recommended_limit",
        "query_execution"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "recommended_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "query_execution": {
          "type": "string",
          "const": "serial"
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategies"
      ],
      "properties": {
        "strategies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "webpage",
              "platform_video",
              "platform_audio",
              "platform_resource",
              "platform_book"
            ]
          }
        }
      }
    },
    "canonical_url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remove_fragment",
        "removable_query_parameters"
      ],
      "properties": {
        "remove_fragment": {
          "type": "boolean",
          "const": true
        },
        "removable_query_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "from",
              "spm_id_from",
              "vd_source",
              "share_source",
              "share_medium",
              "from_tab",
              "previous_page",
              "mode",
              "enter_from",
              "share_token",
              "source",
              "fbclid",
              "gclid",
              "msclkid",
              "utm_campaign",
              "utm_content",
              "utm_medium",
              "utm_source",
              "utm_term"
            ]
          }
        }
      }
    },
    "identity_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_id_fields",
        "strong_identity_sources",
        "weak_identity_fields",
        "canonical_url"
      ],
      "properties": {
        "native_id_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "strong_identity_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "native_id",
              "isbn",
              "doi",
              "canonical_url"
            ]
          }
        },
        "weak_identity_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "title",
              "creator",
              "edition"
            ]
          }
        },
        "canonical_url": {
          "$ref": "#/$defs/canonical_url"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "display_name",
        "resource_types",
        "capabilities",
        "auth_mode",
        "auth_kind",
        "source_traits",
        "search",
        "inspection",
        "acquisition",
        "identity_profile"
      ],
      "properties": {
        "platform_id": {
          "$ref": "#/$defs/platform_id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resource_type"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "auth_mode": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "auth_kind": {
          "type": "string",
          "enum": [
            "none",
            "cookie",
            "token"
          ]
        },
        "source_traits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "archive",
              "audio",
              "community",
              "creator",
              "document",
              "education",
              "government",
              "library",
              "media",
              "open_course",
              "reference",
              "search_engine",
              "video",
              "web"
            ]
          }
        },
        "search": {
          "$ref": "#/$defs/search"
        },
        "inspection": {
          "$ref": "#/$defs/inspection"
        },
        "acquisition": {
          "$ref": "#/$defs/acquisition"
        },
        "identity_profile": {
          "$ref": "#/$defs/identity_profile"
        }
      }
    }
  }
}
