{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_flow_list.schema.json",
  "title": "resource_flow_list contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
      }
    },
    "flow_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "query", "status", "created_at", "updated_at"],
      "properties": {
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "query": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"type": "string"},
        "created_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "updated_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "flows", "count"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flows": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/flow_summary"}
        },
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
