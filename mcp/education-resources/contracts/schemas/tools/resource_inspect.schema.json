{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_inspect.schema.json",
  "title": "resource_inspect contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "resource_id", "idempotency_key"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "auth_required", "unavailable", "unknown", "policy_blocked"]
        },
        "reason_code": {"$ref": "../../error-codes.json#/$defs/error_code"},
        "message": {"type": "string", "maxLength": 512}
      }
    },
    "public_representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation_id", "kind"],
      "properties": {
        "representation_id": {"$ref": "../common.schema.json#/$defs/representation_id"},
        "scope": {"$ref": "../common.schema.json#/$defs/capability_scope"},
        "kind": {
          "type": "string",
          "enum": ["webpage", "document", "video", "audio", "image", "subtitle", "other"]
        },
        "container": {
          "type": "string", "minLength": 1, "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "mime_type": {
          "type": "string", "minLength": 3, "maxLength": 127,
          "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "role": {
          "type": "string", "minLength": 1, "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "language": {"type": "string", "minLength": 2, "maxLength": 35},
        "estimated_size_bytes": {"type": "integer", "minimum": 0},
        "materializable": {"type": "boolean"},
        "requires_auth": {"type": "boolean"},
        "technical_availability": {
          "type": "string",
          "enum": ["available", "auth_required", "unavailable", "unknown", "policy_blocked"]
        }
      }
    },
    "public_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "availability", "representations"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "resource_type": {"$ref": "../common.schema.json#/$defs/resource_type"},
        "summary": {"type": "string", "maxLength": 4000},
        "creator": {"type": "string", "minLength": 1, "maxLength": 256},
        "creator_id": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "description": "Platform-native creator handle when Inspect can expose one, for example Douyin sec_uid."
        },
        "language": {"type": "string", "minLength": 2, "maxLength": 35},
        "availability": {"$ref": "#/$defs/availability"},
        "representations": {
          "type": "array", "maxItems": 32,
          "items": {"$ref": "#/$defs/public_representation"}
        }
      }
    },
    "success": {
      "description": "Internal domain-service inspect shape retained for service-level fixture validation. Public MCP emits public_success.",
      "type": "object",
      "required": [
        "contract_version", "ok", "flow_id", "resource_id", "resolution_status",
        "resolved_resource", "inspection", "failures"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"}
      },
      "additionalProperties": true
    },
    "public_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "resource_id", "resolution_status",
        "resource", "failures", "warnings"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "resolution_status": {
          "type": "string",
          "enum": ["resolved", "partial", "unresolved", "landing_only", "metadata_only"]
        },
        "resource": {"$ref": "#/$defs/public_resource"},
        "failures": {
          "type": "array", "maxItems": 32,
          "items": {"$ref": "../common.schema.json#/$defs/item_failure"}
        },
        "warnings": {
          "type": "array", "maxItems": 32,
          "items": {"type": "string", "maxLength": 512}
        },
        "inspected_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/public_success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
