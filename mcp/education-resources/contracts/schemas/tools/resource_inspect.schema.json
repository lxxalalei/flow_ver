{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_inspect.schema.json",
  "title": "resource_inspect contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id",
        "resource_id",
        "idempotency_key"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "resource_id": {
          "$ref": "../common.schema.json#/$defs/resource_id"
        },
        "idempotency_key": {
          "$ref": "../common.schema.json#/$defs/idempotency_key"
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "auth_required",
            "unavailable",
            "unknown",
            "policy_blocked"
          ]
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation_id",
        "kind"
      ],
      "properties": {
        "representation_id": {
          "$ref": "../common.schema.json#/$defs/representation_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "webpage",
            "document",
            "video",
            "audio",
            "image",
            "subtitle",
            "other"
          ]
        },
        "container": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "mime_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "estimated_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "materializable": {
          "type": "boolean"
        },
        "requires_auth": {
          "type": "boolean"
        },
        "rights_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "resolved_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "resource_type",
        "availability",
        "representations",
        "metadata"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resource_type": {
          "$ref": "../common.schema.json#/$defs/resource_type"
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "representations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/representation"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspector_id",
        "version",
        "method",
        "cache_status",
        "inspected_at",
        "warnings"
      ],
      "properties": {
        "inspector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cache_status": {
          "type": "string",
          "enum": [
            "hit",
            "miss",
            "refresh"
          ]
        },
        "inspected_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "resource_id",
        "resolution_id",
        "resolution_status",
        "resolved_resource",
        "inspection",
        "failures"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "resource_id": {
          "$ref": "../common.schema.json#/$defs/resource_id"
        },
        "resolution_id": {
          "$ref": "../common.schema.json#/$defs/resolution_id"
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "resolved",
            "partial",
            "unresolved"
          ]
        },
        "resolved_resource": {
          "$ref": "#/$defs/resolved_resource"
        },
        "inspection": {
          "$ref": "#/$defs/inspection"
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/item_failure"
          }
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
