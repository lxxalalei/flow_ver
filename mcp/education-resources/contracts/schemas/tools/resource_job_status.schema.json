{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_job_status.schema.json",
  "title": "resource_job_status contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id",
        "job_id"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "job_id": {
          "$ref": "../common.schema.json#/$defs/job_id"
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "completed_items",
        "total_items"
      ],
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "completed_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "plan_id",
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest",
        "plan_digest",
        "job_id",
        "status",
        "progress",
        "assets",
        "failures",
        "updated_at"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "plan_id": {
          "$ref": "../common.schema.json#/$defs/plan_id"
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "../common.schema.json#/$defs/selection_digest"
        },
        "job_id": {
          "$ref": "../common.schema.json#/$defs/job_id"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/job_status"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "assets": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "../common.schema.json#/$defs/asset_summary"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "../common.schema.json#/$defs/item_failure"
          }
        },
        "updated_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "plan_digest": {
          "$ref": "../common.schema.json#/$defs/plan_digest"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
