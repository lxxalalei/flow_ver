{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_job_status.schema.json",
  "title": "resource_job_status contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "job_id"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "completed_items", "total_items"],
      "properties": {
        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "completed_items": {"type": "integer", "minimum": 0},
        "total_items": {"type": "integer", "minimum": 0, "maximum": 50},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "public_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "resource_id", "media_type", "size_bytes"],
      "properties": {
        "asset_id": {"$ref": "../common.schema.json#/$defs/asset_id"},
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
        "size_bytes": {"type": "integer", "minimum": 0},
        "bundle_id": {"$ref": "../common.schema.json#/$defs/bundle_id"},
        "role": {"$ref": "../common.schema.json#/$defs/asset_role"},
        "order": {"$ref": "../common.schema.json#/$defs/bundle_order"},
        "bundle_completion": {"$ref": "../common.schema.json#/$defs/bundle_completion"}
      }
    },
    "success": {
      "description": "Internal domain-service job shape retained for service-level fixture validation. Public MCP emits public_success.",
      "type": "object",
      "required": [
        "contract_version", "ok", "flow_id", "job_id", "status",
        "progress", "assets", "failures"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"}
      },
      "additionalProperties": true
    },
    "public_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "job_id", "status",
        "progress", "assets", "failures"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"},
        "status": {"$ref": "../common.schema.json#/$defs/job_status"},
        "completion": {"$ref": "../common.schema.json#/$defs/bundle_completion"},
        "progress": {"$ref": "#/$defs/progress"},
        "assets": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/public_asset"}
        },
        "failures": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "../common.schema.json#/$defs/item_failure"}
        },
        "updated_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/public_success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
