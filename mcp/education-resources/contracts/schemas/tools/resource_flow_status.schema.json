{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_flow_status.schema.json",
  "title": "resource_flow_status contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"}
      }
    },
    "success": {
      "description": "Internal domain-service status shape retained for service-level fixture validation. Public MCP emits public_success.",
      "type": "object",
      "required": [
        "contract_version", "ok", "flow_id", "stage", "task",
        "current_result_set", "current_presentation", "current_selection",
        "current_plan", "current_job", "current_resolutions", "allowed_next_actions"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"}
      },
      "additionalProperties": true
    },
    "candidate_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "platform", "title", "resource_type"],
      "properties": {
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "platform": {"$ref": "../common.schema.json#/$defs/platform_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "resource_type": {"$ref": "../common.schema.json#/$defs/resource_type"}
      }
    },
    "result_set_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "round", "candidate_count", "candidate_refs", "candidate_refs_complete"],
      "properties": {
        "status": {"$ref": "../common.schema.json#/$defs/result_set_status"},
        "round": {"type": "integer", "minimum": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidate_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/candidate_ref"}
        },
        "candidate_refs_complete": {
          "type": "boolean",
          "description": "False means the durable ResultSet contains more candidates than the compact recovery summary exposes."
        }
      }
    },
    "presented_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_position", "resource_id"],
      "properties": {
        "display_position": {"type": "integer", "minimum": 1, "maximum": 50},
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "presentation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "empty"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/presented_item"}
        },
        "empty": {"type": "boolean"}
      }
    },
    "selection_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "selected_positions", "selected_resource_ids"],
      "properties": {
        "stage": {"type": "string", "enum": ["selected", "cancelled"]},
        "selected_positions": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 50}
        },
        "selected_resource_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "../common.schema.json#/$defs/resource_id"}
        }
      }
    },
    "plan_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "status", "expires_at", "confirmation_required"],
      "properties": {
        "plan_id": {"$ref": "../common.schema.json#/$defs/plan_id"},
        "status": {"type": "string", "enum": ["prepared", "consumed", "expired", "invalidated"]},
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "confirmation_required": {"type": "boolean"}
      }
    },
    "job_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "progress_percent", "asset_ids", "failures"],
      "properties": {
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"},
        "status": {"$ref": "../common.schema.json#/$defs/job_status"},
        "completion": {"$ref": "../common.schema.json#/$defs/bundle_completion"},
        "progress_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "asset_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "../common.schema.json#/$defs/asset_id"}
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "../common.schema.json#/$defs/item_failure"}
        }
      }
    },
    "public_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "stage", "task",
        "current_result_set", "current_presentation", "current_selection",
        "current_plan", "current_job", "inspected_resource_ids", "allowed_next_actions"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"$ref": "../common.schema.json#/$defs/flow_stage"},
        "task": {"$ref": "../common.schema.json#/$defs/persisted_flow_task"},
        "current_result_set": {
          "oneOf": [{"$ref": "#/$defs/result_set_summary"}, {"type": "null"}]
        },
        "current_presentation": {
          "oneOf": [{"$ref": "#/$defs/presentation_summary"}, {"type": "null"}]
        },
        "current_selection": {
          "oneOf": [{"$ref": "#/$defs/selection_summary"}, {"type": "null"}]
        },
        "current_plan": {
          "oneOf": [{"$ref": "#/$defs/plan_summary"}, {"type": "null"}]
        },
        "current_job": {
          "oneOf": [{"$ref": "#/$defs/job_summary"}, {"type": "null"}]
        },
        "inspected_resource_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "../common.schema.json#/$defs/resource_id"}
        },
        "allowed_next_actions": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "resource_flow_status", "resource_search", "resource_browse_creator",
              "resource_presentation_save", "resource_selection_save", "resource_inspect",
              "resource_download_prepare", "resource_download_start", "resource_job_status",
              "resource_job_cancel", "resource_archive", "resource_library_search"
            ]
          }
        }
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/public_success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
