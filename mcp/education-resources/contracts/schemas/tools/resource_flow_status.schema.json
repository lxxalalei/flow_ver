{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_flow_status.schema.json",
  "title": "resource_flow_status contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        }
      }
    },
    "result_set_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_version",
        "search_run_id",
        "result_set_id",
        "result_version",
        "status",
        "platform_runs",
        "candidates",
        "failures",
        "has_more",
        "created_at"
      ],
      "properties": {
        "task_version": {
          "type": "integer",
          "minimum": 1
        },
        "search_run_id": {
          "$ref": "../common.schema.json#/$defs/search_run_id"
        },
        "result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        },
        "result_version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/result_set_status"
        },
        "platform_runs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "resource_search.schema.json#/$defs/platform_run"
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_candidate"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/item_failure"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "mode": {
          "$ref": "resource_search.schema.json#/$defs/search_mode"
        },
        "base_result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "resource_search.schema.json#/$defs/provenance"
        },
        "coverage": {
          "$ref": "resource_search.schema.json#/$defs/coverage"
        }
      }
    },
    "presentation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_set_id",
        "presentation_id",
        "presented_version",
        "items",
        "empty",
        "created_at"
      ],
      "properties": {
        "result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "../common.schema.json#/$defs/displayed_item"
          }
        },
        "empty": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "selection_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest",
        "selected_positions",
        "selected_resource_ids",
        "cancelled",
        "updated_at"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "selected",
            "cancelled"
          ]
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "../common.schema.json#/$defs/selection_digest"
        },
        "selected_positions": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "selected_resource_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_id"
          }
        },
        "cancelled": {
          "type": "boolean"
        },
        "updated_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "plan_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest",
        "plan_digest",
        "status",
        "expires_at",
        "confirmation_required",
        "created_at"
      ],
      "properties": {
        "plan_id": {
          "$ref": "../common.schema.json#/$defs/plan_id"
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "../common.schema.json#/$defs/selection_digest"
        },
        "plan_digest": {
          "$ref": "../common.schema.json#/$defs/plan_digest"
        },
        "authority_digest": {
          "$ref": "../common.schema.json#/$defs/authority_digest"
        },
        "status": {
          "type": "string",
          "enum": [
            "prepared",
            "consumed",
            "expired",
            "invalidated"
          ]
        },
        "expires_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "confirmation_required": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "job_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "plan_id",
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest",
        "plan_digest",
        "status",
        "progress_percent",
        "asset_ids",
        "failures",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "job_id": {
          "$ref": "../common.schema.json#/$defs/job_id"
        },
        "plan_id": {
          "$ref": "../common.schema.json#/$defs/plan_id"
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "../common.schema.json#/$defs/selection_digest"
        },
        "plan_digest": {
          "$ref": "../common.schema.json#/$defs/plan_digest"
        },
        "authority_digest": {
          "$ref": "../common.schema.json#/$defs/authority_digest"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/job_status"
        },
        "completion": {
          "$ref": "../common.schema.json#/$defs/bundle_completion"
        },
        "progress_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "asset_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/asset_id"
          }
        },
        "bundle_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/bundle_id"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/item_failure"
          }
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "current_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "resource_id",
        "resolution_id",
        "resolution_status",
        "resolved_resource",
        "inspection",
        "failures"
      ],
      "properties": {
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "resource_id": {
          "$ref": "../common.schema.json#/$defs/resource_id"
        },
        "resolution_id": {
          "$ref": "../common.schema.json#/$defs/resolution_id"
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "resolved",
            "partial",
            "unresolved"
          ]
        },
        "resolved_resource": {
          "$ref": "resource_inspect.schema.json#/$defs/resolved_resource"
        },
        "inspection": {
          "$ref": "resource_inspect.schema.json#/$defs/inspection"
        },
        "failures": {
          "$ref": "resource_inspect.schema.json#/$defs/success/properties/failures"
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "task_version",
        "task",
        "stage",
        "allowed_next_actions",
        "created_at",
        "updated_at",
        "current_result_set",
        "current_presentation",
        "current_selection",
        "current_plan",
        "current_job",
        "current_resolutions"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "task_version": {
          "type": "integer",
          "minimum": 1
        },
        "task": {
          "$ref": "../common.schema.json#/$defs/persisted_flow_task"
        },
        "stage": {
          "$ref": "../common.schema.json#/$defs/flow_stage"
        },
        "current_result_set": {
          "oneOf": [
            {
              "$ref": "#/$defs/result_set_snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_presentation": {
          "oneOf": [
            {
              "$ref": "#/$defs/presentation_snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_selection": {
          "oneOf": [
            {
              "$ref": "#/$defs/selection_snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_plan": {
          "oneOf": [
            {
              "$ref": "#/$defs/plan_snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_job": {
          "oneOf": [
            {
              "$ref": "#/$defs/job_snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_resolutions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/current_resolution"
          }
        },
        "allowed_next_actions": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "resource_flow_status",
              "resource_search",
              "resource_browse_creator",
              "resource_presentation_save",
              "resource_selection_save",
              "resource_inspect",
              "resource_download_prepare",
              "resource_download_start",
              "resource_job_status",
              "resource_job_cancel",
              "resource_archive",
              "resource_library_search"
            ]
          }
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
