{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_search.schema.json",
  "title": "resource_search contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "SearchFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_types": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "../common.schema.json#/$defs/resource_type"}
        },
        "languages": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 35}
        },
        "published_after": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "SearchTaskQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "SearchTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "queries"],
      "properties": {
        "platform": {"$ref": "../common.schema.json#/$defs/platform_id"},
        "queries": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {"$ref": "#/$defs/SearchTaskQuery"}
        },
        "direction": {
          "type": "string", "minLength": 1, "maxLength": 256,
          "description": "Semantic search purpose; not an authoritative identifier."
        }
      }
    },
    "search_mode": {"type": "string", "enum": ["replace", "extend"]},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "idempotency_key", "search_tasks"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"},
        "search_tasks": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/SearchTask"}
        },
        "filters": {"$ref": "#/$defs/SearchFilters"},
        "limit": {
          "description": "Maximum results requested from each platform adapter per query. Default is intentionally small; raise it only for broader enumeration.",
          "type": "integer", "minimum": 1, "maximum": 200, "default": 8
        },
        "mode": {
          "$ref": "#/$defs/search_mode",
          "default": "replace",
          "description": "When extend is used, the server binds to the current ResultSet; clients do not submit a base_result_set_id."
        }
      }
    },
    "success": {
      "description": "Internal domain-service success shape retained for service-level fixture validation. Public MCP output is public_success.",
      "type": "object",
      "required": ["contract_version", "ok", "flow_id", "candidates"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "candidates": {"type": "array"}
      },
      "additionalProperties": true
    },
    "public_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id", "platform", "title", "resource_type", "canonical_url",
        "availability", "summary_complete"
      ],
      "properties": {
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "platform": {"$ref": "../common.schema.json#/$defs/platform_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "resource_type": {"$ref": "../common.schema.json#/$defs/resource_type"},
        "canonical_url": {"$ref": "../common.schema.json#/$defs/http_url"},
        "availability": {"$ref": "../common.schema.json#/$defs/availability"},
        "summary": {
          "type": "string", "maxLength": 600,
          "description": "Bounded excerpt of the durable candidate summary."
        },
        "summary_complete": {
          "type": "boolean",
          "description": "False explicitly indicates the public summary was shortened or deliberately omitted; the complete candidate remains server-side and can be Inspect-ed when needed."
        },
        "author": {"type": "string", "minLength": 1, "maxLength": 256},
        "language": {"type": "string", "minLength": 2, "maxLength": 35},
        "duration_seconds": {"type": "integer", "minimum": 0},
        "published_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "rights_hint": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "public_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "stage", "status", "candidate_count",
        "candidates", "failures"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"type": "string", "const": "reviewing"},
        "status": {"$ref": "../common.schema.json#/$defs/result_set_status"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/public_candidate"}
        },
        "failures": {
          "type": "array", "maxItems": 32,
          "items": {"$ref": "../common.schema.json#/$defs/item_failure"}
        },
        "round": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/public_success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
