{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_search.schema.json",
  "title": "resource_search contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "SearchFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_types": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_type"
          }
        },
        "languages": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          }
        },
        "published_after": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "SearchTaskQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "SearchTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "queries"
      ],
      "properties": {
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform_id"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/SearchTaskQuery"
          }
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Semantic search purpose; this is not an authoritative identifier."
        }
      }
    },
    "search_mode": {
      "type": "string",
      "enum": [
        "replace",
        "extend"
      ]
    },
    "bounded_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_candidate_count",
        "new_unique_count",
        "duplicate_count",
        "duplicate_of_base_count",
        "duplicate_within_round_count",
        "identity_unknown_count",
        "new_displayable_count"
      ],
      "properties": {
        "raw_candidate_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "new_unique_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "duplicate_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "duplicate_of_base_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "duplicate_within_round_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "identity_unknown_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "new_displayable_count": {
          "description": "New unique candidates from this search round that remain in the persisted ResultSet after applying the immutable snapshot's total-capacity limit.",
          "$ref": "#/$defs/bounded_count"
        }
      }
    },
    "coverage_dimension": {
      "description": "Persisted factual-gap dimension. target/use/constraints/form/selection remain accepted only for legacy stored rows. The active Search emitter currently emits only source/inspection; availability is reserved for concrete Resolution-derived facts and is not inferred by Search. This is not a Skill semantic Gap.",
      "type": "string",
      "enum": [
        "target",
        "use",
        "constraints",
        "form",
        "source",
        "availability",
        "selection",
        "inspection"
      ]
    },
    "coverage_resource_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "count"
      ],
      "properties": {
        "resource_type": {
          "$ref": "../common.schema.json#/$defs/resource_type"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage_gap": {
      "description": "A bounded server-observed factual gap. It must not be interpreted as a Skill semantic Gap or StopDecision.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "reason",
        "count"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/coverage_dimension"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "description": "Immutable MCP factual summary for one ResultSet. It records server-observed counts and factual gaps only; it is not semantic sufficiency, a recommendation decision, or an offline-oracle result.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_count",
        "platform_count",
        "resource_types",
        "gaps"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "factual"
        },
        "schema_version": {
          "type": "string",
          "const": "factual-coverage-v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "empty",
            "partial",
            "covered"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "platform_count": {
          "type": "integer",
          "minimum": 0
        },
        "resource_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_resource_type"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_gap"
          }
        }
      }
    },
    "query_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "candidate_count",
        "failure_count"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Semantic search purpose attached by the service; not an authoritative identifier."
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "new_unique_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "duplicate_count": {
          "$ref": "#/$defs/bounded_count"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "platform_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "status",
        "query_runs"
      ],
      "properties": {
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform_id"
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Semantic search purpose; this is not an authoritative identifier."
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "partial",
            "failed",
            "skipped"
          ]
        },
        "query_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/query_run"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id",
        "task_version",
        "idempotency_key",
        "search_tasks"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "task_version": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_key": {
          "$ref": "../common.schema.json#/$defs/idempotency_key"
        },
        "search_tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/SearchTask"
          }
        },
        "filters": {
          "$ref": "#/$defs/SearchFilters"
        },
        "limit": {
          "description": "Total candidate capacity of the new immutable ResultSet. In extend mode this capacity includes candidates copied from the base ResultSet; it is not an incremental quota.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "mode": {
          "$ref": "#/$defs/search_mode",
          "default": "replace"
        },
        "base_result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "extend"
              }
            }
          },
          "then": {
            "required": [
              "base_result_set_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "base_result_set_id"
              ]
            }
          }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "task_version",
        "search_run_id",
        "result_set_id",
        "result_version",
        "stage",
        "status",
        "platform_runs",
        "candidates",
        "failures",
        "has_more",
        "created_at"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "task_version": {
          "type": "integer",
          "minimum": 1
        },
        "search_run_id": {
          "$ref": "../common.schema.json#/$defs/search_run_id"
        },
        "result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        },
        "result_version": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "type": "string",
          "const": "reviewing"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/result_set_status"
        },
        "platform_runs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/platform_run"
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_candidate"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/item_failure"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "mode": {
          "$ref": "#/$defs/search_mode"
        },
        "base_result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
