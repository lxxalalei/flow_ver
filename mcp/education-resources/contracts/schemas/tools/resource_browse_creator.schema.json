{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_browse_creator.schema.json",
  "title": "resource_browse_creator contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id",
        "idempotency_key",
        "platform",
        "creator_id"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "task_version": {
          "type": "integer",
          "minimum": 1
        },
        "idempotency_key": {
          "$ref": "../common.schema.json#/$defs/idempotency_key"
        },
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform_id"
        },
        "creator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Platform-native creator handle, not a display name. For douyin: the sec_uid (MS4wLjAB...) or a full /user/ profile URL. Source: search/inspect candidate metadata field creator_sec_uid."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "task_version",
        "search_run_id",
        "result_set_id",
        "result_version",
        "stage",
        "status",
        "platform_runs",
        "candidates",
        "failures",
        "has_more",
        "created_at"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "task_version": {
          "type": "integer",
          "minimum": 1
        },
        "search_run_id": {
          "$ref": "../common.schema.json#/$defs/search_run_id"
        },
        "result_set_id": {
          "$ref": "../common.schema.json#/$defs/result_set_id"
        },
        "result_version": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "type": "string",
          "const": "reviewing"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/result_set_status"
        },
        "platform_runs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "resource_search.schema.json#/$defs/platform_run"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_candidate"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/item_failure"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
