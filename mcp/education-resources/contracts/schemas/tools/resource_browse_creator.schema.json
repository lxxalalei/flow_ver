{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_browse_creator.schema.json",
  "title": "resource_browse_creator contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "idempotency_key", "platform", "creator_id"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"},
        "platform": {"$ref": "../common.schema.json#/$defs/platform_id"},
        "creator_id": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "description": "Platform-native creator handle, not a display name. Use resource.creator_id from Inspect when available."
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
      }
    },
    "success": {
      "description": "Internal domain-service success shape retained for service-level fixture validation. Public MCP output is public_success.",
      "type": "object",
      "required": ["contract_version", "ok", "flow_id", "candidates"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "candidates": {"type": "array"}
      },
      "additionalProperties": true
    },
    "public_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "stage", "status", "candidate_count",
        "candidates", "failures"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"type": "string", "const": "reviewing"},
        "status": {"$ref": "../common.schema.json#/$defs/result_set_status"},
        "candidate_count": {"type": "integer", "minimum": 0},
        "candidates": {
          "type": "array", "maxItems": 200,
          "items": {"$ref": "resource_search.schema.json#/$defs/public_candidate"}
        },
        "failures": {
          "type": "array", "maxItems": 32,
          "items": {"$ref": "../common.schema.json#/$defs/item_failure"}
        },
        "round": {"type": "integer", "minimum": 1}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/public_success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
