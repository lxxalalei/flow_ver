{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_library_search.schema.json",
  "title": "resource_library_search contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "taxonomy_versions": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "../common.schema.json#/$defs/taxonomy_version"
          }
        },
        "classification_statuses": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "../common.schema.json#/$defs/classification_status"
          }
        },
        "primary_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "deprecated": true,
          "description": "Compatibility-only singular filter; primary_domains is canonical."
        },
        "primary_domains": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "../common.schema.json#/$defs/learning_domain_id"
          }
        },
        "secondary_domains": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "../common.schema.json#/$defs/learning_domain_id"
          }
        },
        "topics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../common.schema.json#/$defs/safe_topic"
          }
        },
        "material_purposes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../common.schema.json#/$defs/material_purpose"
          }
        },
        "grade_levels": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../common.schema.json#/$defs/grade_level"
          }
        },
        "difficulties": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "../common.schema.json#/$defs/difficulty"
          }
        },
        "curriculum_versions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../common.schema.json#/$defs/curriculum_version"
          }
        },
        "platforms": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "../common.schema.json#/$defs/platform_id"
          }
        },
        "resource_types": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_type"
          }
        },
        "resource_formats": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_format"
          }
        },
        "collections": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "tags": {
          "$ref": "../common.schema.json#/$defs/string_tags"
        },
        "archived_after": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "archived_before": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "library_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_id",
        "asset_id",
        "resource_id",
        "platform",
        "title",
        "resource_type",
        "resource_format",
        "media_type",
        "size_bytes",
        "sha256",
        "archived_at",
        "tags",
        "classification",
        "primary_domain_display_name"
      ],
      "properties": {
        "archive_id": {
          "$ref": "../common.schema.json#/$defs/archive_id"
        },
        "asset_id": {
          "$ref": "../common.schema.json#/$defs/asset_id"
        },
        "bundle_id": {
          "$ref": "../common.schema.json#/$defs/bundle_id"
        },
        "role": {
          "$ref": "../common.schema.json#/$defs/asset_role"
        },
        "order": {
          "$ref": "../common.schema.json#/$defs/bundle_order"
        },
        "bundle_completion": {
          "$ref": "../common.schema.json#/$defs/bundle_completion"
        },
        "resource_id": {
          "$ref": "../common.schema.json#/$defs/resource_id"
        },
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resource_type": {
          "$ref": "../common.schema.json#/$defs/resource_type"
        },
        "resource_format": {
          "$ref": "../common.schema.json#/$defs/resource_format"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "collection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "primary_domain": {
          "$ref": "../common.schema.json#/$defs/learning_domain_id",
          "deprecated": true,
          "description": "Compatibility projection of classification.primary_domain."
        },
        "classification": {
          "$ref": "../common.schema.json#/$defs/archive_classification"
        },
        "primary_domain_display_name": {
          "$ref": "../common.schema.json#/$defs/learning_domain_display_name"
        },
        "relative_path": {
          "$ref": "../common.schema.json#/$defs/relative_library_path"
        },
        "library_path": {
          "$ref": "../common.schema.json#/$defs/relative_library_path",
          "deprecated": true,
          "description": "Compatibility alias; never an absolute local path."
        },
        "tags": {
          "$ref": "../common.schema.json#/$defs/string_tags"
        },
        "archived_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "cursor": {
          "$ref": "../common.schema.json#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "assets",
        "has_more"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "assets": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/library_asset"
          }
        },
        "next_cursor": {
          "$ref": "../common.schema.json#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
