{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_download_prepare.schema.json",
  "title": "resource_download_prepare contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_container": {
          "type": "string",
          "enum": ["original", "pdf", "epub", "mp4", "mp3", "m4a", "html", "text"]
        },
        "allow_safe_fallback": {
          "type": "boolean",
          "default": false,
          "description": "Compatibility preference only. Provider routing is exact and does not silently switch to another Provider after failure."
        }
      }
    },
    "plan_item": {"$ref": "../plan-item.schema.json"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "flow_id", "idempotency_key", "presentation_id",
        "presented_version", "selection_version", "selection_digest"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"},
        "presentation_id": {"$ref": "../common.schema.json#/$defs/presentation_id"},
        "presented_version": {"type": "integer", "minimum": 1},
        "selection_version": {"type": "integer", "minimum": 1},
        "selection_digest": {"$ref": "../common.schema.json#/$defs/selection_digest"},
        "options": {"$ref": "#/$defs/options"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "stage", "plan_id",
        "presentation_id", "presented_version", "selection_version",
        "selection_digest", "plan_digest", "expires_at",
        "confirmation_required", "confirmation_token", "items"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"type": "string", "const": "prepared"},
        "plan_id": {"$ref": "../common.schema.json#/$defs/plan_id"},
        "presentation_id": {"$ref": "../common.schema.json#/$defs/presentation_id"},
        "presented_version": {"type": "integer", "minimum": 1},
        "selection_version": {"type": "integer", "minimum": 1},
        "selection_digest": {"$ref": "../common.schema.json#/$defs/selection_digest"},
        "plan_digest": {"$ref": "../common.schema.json#/$defs/plan_digest"},
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "confirmation_required": {"const": true},
        "confirmation_token": {"$ref": "../common.schema.json#/$defs/confirmation_token"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "#/$defs/plan_item"}
        }
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
