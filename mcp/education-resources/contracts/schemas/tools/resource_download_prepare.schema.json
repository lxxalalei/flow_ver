{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_download_prepare.schema.json",
  "title": "resource_download_prepare contract",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "preferred_container": {
          "type": "string",
          "enum": [
            "original",
            "pdf",
            "epub",
            "mp4",
            "mp3",
            "html",
            "text"
          ]
        },
        "max_bytes_per_resource": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5368709120
        },
        "allow_safe_fallback": {
          "type": "boolean",
          "default": true,
          "description": "Compatibility preference only. When true, the server may follow a fallback edge that is explicitly declared by the bound capability descriptor and deployment-readiness snapshot, and that remains valid after per-resource revalidation. This flag never authorizes a different Provider, platform, capability, scope, representation, or strategy; generic Provider takeover and landing/metadata substitution for a primary resource are forbidden. When no bound fallback exists, the server must reject or keep the original capability rather than infer a fallback."
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "level",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "level": {
          "$ref": "../common.schema.json#/$defs/risk_level"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "plan_item": {
      "$ref": "../plan-item.schema.json"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id",
        "idempotency_key",
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "idempotency_key": {
          "$ref": "../common.schema.json#/$defs/idempotency_key"
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "../common.schema.json#/$defs/selection_digest"
        },
        "options": {
          "$ref": "#/$defs/options"
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "stage",
        "plan_id",
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest",
        "plan_digest",
        "expires_at",
        "confirmation_required",
        "confirmation_token",
        "items"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "stage": {
          "type": "string",
          "const": "prepared"
        },
        "plan_id": {
          "$ref": "../common.schema.json#/$defs/plan_id"
        },
        "presentation_id": {
          "$ref": "../common.schema.json#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "../common.schema.json#/$defs/selection_digest"
        },
        "expires_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "confirmation_required": {
          "const": true
        },
        "confirmation_token": {
          "$ref": "../common.schema.json#/$defs/confirmation_token"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/plan_item"
          }
        },
        "plan_digest": {
          "$ref": "../common.schema.json#/$defs/plan_digest"
        },
        "authority_digest": {
          "$ref": "../common.schema.json#/$defs/authority_digest"
        },
        "capability_binding_version": {
          "$ref": "../common.schema.json#/$defs/capability_binding_version"
        }
      },
      "dependentRequired": {
        "authority_digest": [
          "capability_binding_version"
        ],
        "capability_binding_version": [
          "authority_digest"
        ]
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
