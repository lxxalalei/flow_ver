{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/tools/resource_download_prepare.schema.json",
  "title": "resource_download_prepare contract",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_container": {
          "type": "string",
          "enum": ["original", "pdf", "epub", "mp4", "mp3", "m4a", "html", "text"]
        },
        "allow_safe_fallback": {
          "type": "boolean", "default": false,
          "description": "Compatibility preference only. Provider routing is exact and does not silently switch Provider after failure."
        }
      }
    },
    "plan_item": {"$ref": "../plan-item.schema.json"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "idempotency_key"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"},
        "options": {"$ref": "#/$defs/options"}
      },
      "description": "The server resolves the current Selection, Presentation version and selection digest from durable Flow state."
    },
    "success": {
      "description": "Internal domain-service success shape retained for service-level fixture validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "stage", "plan_id",
        "presentation_id", "presented_version", "selection_version",
        "selection_digest", "plan_digest", "expires_at",
        "confirmation_required", "confirmation_token", "items"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"type": "string", "const": "prepared"},
        "plan_id": {"$ref": "../common.schema.json#/$defs/plan_id"},
        "presentation_id": {"$ref": "../common.schema.json#/$defs/presentation_id"},
        "presented_version": {"type": "integer", "minimum": 1},
        "selection_version": {"type": "integer", "minimum": 1},
        "selection_digest": {"$ref": "../common.schema.json#/$defs/selection_digest"},
        "plan_digest": {"$ref": "../common.schema.json#/$defs/plan_digest"},
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "confirmation_required": {"const": true},
        "confirmation_token": {"$ref": "../common.schema.json#/$defs/confirmation_token"},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {"$ref": "#/$defs/plan_item"}
        }
      }
    },
    "public_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id", "selected_position", "platform", "planned_scope",
        "planned_container", "estimated_size_bytes", "risks"
      ],
      "properties": {
        "resource_id": {"$ref": "../common.schema.json#/$defs/resource_id"},
        "selected_position": {"type": "integer", "minimum": 1, "maximum": 50},
        "platform": {"$ref": "../common.schema.json#/$defs/platform_id"},
        "planned_scope": {"$ref": "../common.schema.json#/$defs/capability_scope"},
        "planned_container": {
          "type": "string",
          "enum": ["original", "pdf", "epub", "mp4", "mp3", "m4a", "html", "text"]
        },
        "estimated_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "risks": {
          "type": "array", "maxItems": 16,
          "items": {"$ref": "../plan-item.schema.json#/$defs/risk"}
        }
      }
    },
    "public_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "ok", "flow_id", "stage", "plan_id", "expires_at",
        "confirmation_required", "confirmation_token", "items"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"type": "string", "const": "prepared"},
        "plan_id": {"$ref": "../common.schema.json#/$defs/plan_id"},
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "confirmation_required": {"const": true},
        "confirmation_token": {"$ref": "../common.schema.json#/$defs/confirmation_token"},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {"$ref": "#/$defs/public_plan_item"}
        }
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/public_success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
