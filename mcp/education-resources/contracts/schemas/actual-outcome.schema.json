{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/schemas/actual-outcome.schema.json",
  "title": "Education resource acquisition outcome",
  "description": "Server-generated actual execution fact for one Job item. It records the planned route and actual result without descriptor/readiness/eligibility or digest credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "outcome_id", "resource_id", "planned_scope",
    "status", "provider", "strategy", "observed_at"
  ],
  "properties": {
    "contract_version": {"$ref": "common.schema.json#/$defs/contract_version"},
    "outcome_id": {"$ref": "common.schema.json#/$defs/actual_outcome_id"},
    "resource_id": {"$ref": "common.schema.json#/$defs/resource_id"},
    "planned_scope": {"$ref": "common.schema.json#/$defs/capability_scope"},
    "actual_scope": {"$ref": "common.schema.json#/$defs/capability_scope"},
    "status": {"$ref": "common.schema.json#/$defs/outcome_status"},
    "provider": {"$ref": "common.schema.json#/$defs/provider_ref"},
    "strategy": {"$ref": "common.schema.json#/$defs/capability_strategy"},
    "representation": {"$ref": "#/$defs/representation"},
    "validation": {"$ref": "#/$defs/validation"},
    "asset_id": {"$ref": "common.schema.json#/$defs/asset_id"},
    "bundle_id": {"$ref": "common.schema.json#/$defs/bundle_id"},
    "failure": {"$ref": "#/$defs/failure"},
    "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "$defs": {
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation_id", "scope", "kind", "role"],
      "properties": {
        "representation_id": {"$ref": "common.schema.json#/$defs/representation_id"},
        "scope": {"$ref": "common.schema.json#/$defs/capability_scope"},
        "kind": {
          "type": "string",
          "enum": ["webpage", "document", "video", "audio", "image", "subtitle", "other"]
        },
        "role": {
          "type": "string",
          "enum": ["primary", "landing", "metadata", "attachment", "companion"]
        },
        "container": {"$ref": "common.schema.json#/$defs/safe_container"},
        "mime_type": {"$ref": "common.schema.json#/$defs/mime_type"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "source_fingerprint": {"$ref": "common.schema.json#/$defs/source_fingerprint"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_type_valid": {"type": "boolean"},
        "format_valid": {"type": "boolean"},
        "path_valid": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retriable"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "retriable": {"type": "boolean"}
      }
    }
  }
}
