{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v2/schemas/tools/resource_job_cancel.schema.json",
  "title": "resource_job_cancel contract v2",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id",
        "job_id",
        "idempotency_key"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "job_id": {
          "$ref": "../common.schema.json#/$defs/job_id"
        },
        "idempotency_key": {
          "$ref": "../common.schema.json#/$defs/idempotency_key"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "job_id",
        "status",
        "cancel_requested_at"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "job_id": {
          "$ref": "../common.schema.json#/$defs/job_id"
        },
        "status": {
          "type": "string",
          "enum": [
            "cancelling",
            "cancelled"
          ]
        },
        "cancel_requested_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
