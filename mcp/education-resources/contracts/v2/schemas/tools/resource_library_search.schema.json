{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v2/schemas/tools/resource_library_search.schema.json",
  "title": "resource_library_search contract v2",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "platforms": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/platform_id"
          }
        },
        "resource_types": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/resource_type"
          }
        },
        "collections": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "tags": {
          "$ref": "../common.schema.json#/$defs/string_tags"
        },
        "archived_after": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "library_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "resource_id",
        "platform",
        "title",
        "resource_type",
        "media_type",
        "size_bytes",
        "sha256",
        "archived_at",
        "tags"
      ],
      "properties": {
        "asset_id": {
          "$ref": "../common.schema.json#/$defs/asset_id"
        },
        "resource_id": {
          "$ref": "../common.schema.json#/$defs/resource_id"
        },
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "resource_type": {
          "$ref": "../common.schema.json#/$defs/resource_type"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "collection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "primary_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "library_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "tags": {
          "$ref": "../common.schema.json#/$defs/string_tags"
        },
        "archived_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "flow_id"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "cursor": {
          "$ref": "../common.schema.json#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "flow_id",
        "assets",
        "has_more"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "flow_id": {
          "$ref": "../common.schema.json#/$defs/flow_id"
        },
        "assets": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/library_asset"
          }
        },
        "next_cursor": {
          "$ref": "../common.schema.json#/$defs/cursor"
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
