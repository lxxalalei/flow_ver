{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v2/schemas/common.schema.json",
  "title": "Education Resource MCP common definitions v2",
  "$defs": {
    "contract_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "flow_id": {
      "type": "string",
      "pattern": "^flow_[A-Za-z0-9_-]{16,64}$"
    },
    "result_set_id": {
      "type": "string",
      "pattern": "^rset_[A-Za-z0-9_-]{16,64}$"
    },
    "presentation_id": {
      "type": "string",
      "pattern": "^pres_[A-Za-z0-9_-]{16,64}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^res_[A-Za-z0-9_-]{16,64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]{16,64}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[A-Za-z0-9_-]{16,64}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^asset_[A-Za-z0-9_-]{16,64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "confirmation_token": {
      "type": "string",
      "minLength": 24,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "selection_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "http_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "platform_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "article",
        "book",
        "document",
        "video",
        "audio",
        "course",
        "dataset",
        "other"
      ]
    },
    "flow_stage": {
      "type": "string",
      "enum": [
        "task_ready",
        "reviewing",
        "presented",
        "selected",
        "cancelled",
        "prepared",
        "downloading",
        "downloaded",
        "failed"
      ]
    },
    "job_status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "result_set_status": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "blocked"
      ]
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "auth_required",
        "unavailable",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "user_role": {
      "type": "string",
      "enum": [
        "child",
        "parent"
      ]
    },
    "resource_target": {
      "type": "string",
      "enum": [
        "child",
        "parent"
      ]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "constraint_id": {
      "type": "string",
      "pattern": "^con_[A-Za-z0-9_-]{16,64}$",
      "description": "Server-generated stable identifier for a persisted task constraint."
    },
    "input_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "persisted_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "kind",
        "value"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_id"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "input_flow_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "constraints"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/goal"
        },
        "user_role": {
          "$ref": "#/$defs/user_role"
        },
        "resource_target": {
          "$ref": "#/$defs/resource_target"
        },
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/input_constraint"
          }
        }
      }
    },
    "persisted_flow_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "constraints"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/goal"
        },
        "user_role": {
          "$ref": "#/$defs/user_role"
        },
        "resource_target": {
          "$ref": "#/$defs/resource_target"
        },
        "constraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/persisted_constraint"
          }
        }
      }
    },
    "error_context_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retriable",
        "context"
      ],
      "properties": {
        "code": {
          "$ref": "../error-codes.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retriable": {
          "type": "boolean"
        },
        "context": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/error_context_entry"
          }
        }
      }
    },
    "error_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "error"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/contract_version"
        },
        "ok": {
          "const": false
        },
        "flow_id": {
          "$ref": "#/$defs/flow_id"
        },
        "result_set_id": {
          "$ref": "#/$defs/result_set_id"
        },
        "presentation_id": {
          "$ref": "#/$defs/presentation_id"
        },
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "plan_id": {
          "$ref": "#/$defs/plan_id"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "resource_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "platform",
        "title",
        "resource_type",
        "canonical_url",
        "availability"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "platform": {
          "$ref": "#/$defs/platform_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "resource_type": {
          "$ref": "#/$defs/resource_type"
        },
        "canonical_url": {
          "$ref": "#/$defs/http_url"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "rights_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "displayed_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_position",
        "resource_id"
      ],
      "properties": {
        "display_position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        }
      }
    },
    "item_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retriable"
      ],
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform_id"
        },
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "code": {
          "$ref": "../error-codes.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retriable": {
          "type": "boolean"
        }
      }
    },
    "asset_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "resource_id",
        "media_type",
        "size_bytes",
        "sha256",
        "validation_status"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/asset_id"
        },
        "resource_id": {
          "$ref": "#/$defs/resource_id"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validation_status": {
          "type": "string",
          "const": "validated"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "binding_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_id",
        "presented_version",
        "selection_version",
        "selection_digest",
        "plan_digest"
      ],
      "properties": {
        "presentation_id": {
          "$ref": "#/$defs/presentation_id"
        },
        "presented_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1
        },
        "selection_digest": {
          "$ref": "#/$defs/selection_digest"
        },
        "plan_digest": {
          "$ref": "#/$defs/plan_digest"
        }
      }
    },
    "string_tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "search_run_id": {
      "type": "string",
      "pattern": "^search_[A-Za-z0-9_-]{16,64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
