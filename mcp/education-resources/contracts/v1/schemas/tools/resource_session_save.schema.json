{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v1/schemas/tools/resource_session_save.schema.json",
  "title": "resource_session_save contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "platform", "session_data"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "platform": {"type": "string", "minLength": 1, "maxLength": 64},
        "session_data": {
          "type": "object",
          "description": "Platform-specific session payload (cookies, storage_state, tokens)."
        },
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "platform", "status", "captured_at"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "platform": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"const": "valid"},
        "captured_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
