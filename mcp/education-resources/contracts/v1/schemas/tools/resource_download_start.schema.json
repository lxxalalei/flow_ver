{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v1/schemas/tools/resource_download_start.schema.json",
  "title": "resource_download_start contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "plan_id", "confirmation_token", "idempotency_key"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "plan_id": {"$ref": "../common.schema.json#/$defs/plan_id"},
        "confirmation_token": {"$ref": "../common.schema.json#/$defs/confirmation_token"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "flow_id", "plan_id", "job_id", "status", "queued_at"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "plan_id": {"$ref": "../common.schema.json#/$defs/plan_id"},
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"},
        "status": {"type": "string", "const": "queued"},
        "queued_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}

