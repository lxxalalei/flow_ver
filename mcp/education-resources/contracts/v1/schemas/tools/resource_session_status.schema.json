{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v1/schemas/tools/resource_session_status.schema.json",
  "title": "resource_session_status contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "platforms": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "deep": {
          "type": "boolean",
          "default": false,
          "description": "When true, actively probe each stored session against its platform so a cookie that is still file-valid but rejected server-side is reported as probe_status=invalid."
        }
      }
    },
    "session_status_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "label", "status", "login_url"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 64},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"type": "string", "enum": ["valid", "expired", "missing"]},
        "login_url": {"type": "string", "maxLength": 512},
        "captured_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "expires_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "probe_status": {
          "type": "string",
          "enum": ["valid", "invalid", "no_probe", "probe_error", "missing"],
          "description": "Present only when deep=true was requested and the platform has a stored session."
        },
        "probed_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "probe_detail": {"type": "string", "maxLength": 512}
      }
    },
    "login_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "label", "login_url"],
      "properties": {
        "platform": {"type": "string", "minLength": 1, "maxLength": 64},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "login_url": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "sessions", "needs_login"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "sessions": {
          "type": "array",
          "items": {"$ref": "#/$defs/session_status_entry"}
        },
        "needs_login": {
          "type": "array",
          "items": {"$ref": "#/$defs/login_entry"}
        }
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
