{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v1/schemas/tools/resource_flow_start.schema.json",
  "title": "resource_flow_start contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "idempotency_key", "intent"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "idempotency_key": {"$ref": "../common.schema.json#/$defs/idempotency_key"},
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic"],
          "properties": {
            "topic": {"type": "string", "minLength": 1, "maxLength": 1000},
            "learning_goal": {"type": "string", "maxLength": 2000},
            "audience": {"type": "string", "enum": ["preschool", "primary", "middle_school", "high_school", "parent", "general"]},
            "resource_types": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"$ref": "../common.schema.json#/$defs/resource_type"}
            },
            "language_preferences": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 2, "maxLength": 35}
            },
            "platform_preferences": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"$ref": "../common.schema.json#/$defs/platform_id"}
            }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "flow_id", "stage", "created_at"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "stage": {"type": "string", "const": "intent_ready"},
        "created_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
