{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/education-resource/v1/schemas/tools/resource_job_status.schema.json",
  "title": "resource_job_status contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "flow_id", "job_id"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_items", "total_items", "percent"],
      "properties": {
        "completed_items": {"type": "integer", "minimum": 0},
        "total_items": {"type": "integer", "minimum": 1},
        "percent": {"type": "number", "minimum": 0, "maximum": 100},
        "bytes_received": {"type": "integer", "minimum": 0},
        "bytes_expected": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "flow_id", "job_id", "status", "progress", "assets", "failures", "updated_at"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "flow_id": {"$ref": "../common.schema.json#/$defs/flow_id"},
        "job_id": {"$ref": "../common.schema.json#/$defs/job_id"},
        "status": {"$ref": "../common.schema.json#/$defs/job_status"},
        "progress": {"$ref": "#/$defs/progress"},
        "assets": {"type": "array", "maxItems": 50, "items": {"$ref": "../common.schema.json#/$defs/asset_summary"}},
        "failures": {"type": "array", "maxItems": 50, "items": {"$ref": "../common.schema.json#/$defs/item_failure"}},
        "updated_at": {"$ref": "../common.schema.json#/$defs/timestamp"},
        "finished_at": {"$ref": "../common.schema.json#/$defs/timestamp"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
