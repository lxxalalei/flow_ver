{
  "$schema": "schemas/tool-catalog.schema.json",
  "catalog_version": "1.0.0",
  "contract_version": "1.0.0",
  "server_id": "learning_resources",
  "tools": [
    {
      "name": "resource_flow_start",
      "description": "Create a server-owned education resource Flow from a bounded learning intent.",
      "side_effect": "state_write",
      "requires_flow_id": false,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_flow_start.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_flow_start.schema.json#/$defs/output"
    },
    {
      "name": "resource_search",
      "description": "Search configured sources, normalize candidates, and persist the presented set for a Flow.",
      "side_effect": "state_write",
      "requires_flow_id": true,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_search.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_search.schema.json#/$defs/output"
    },
    {
      "name": "resource_selection_save",
      "description": "Save the explicit selection for the current presented set.",
      "side_effect": "state_write",
      "requires_flow_id": true,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_selection_save.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_selection_save.schema.json#/$defs/output"
    },
    {
      "name": "resource_download_prepare",
      "description": "Validate the saved selection and create an expiring download Plan without downloading.",
      "side_effect": "state_write",
      "requires_flow_id": true,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_download_prepare.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_download_prepare.schema.json#/$defs/output"
    },
    {
      "name": "resource_download_start",
      "description": "Consume a confirmed Plan and enqueue an asynchronous download Job.",
      "side_effect": "job_control",
      "requires_flow_id": true,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_download_start.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_download_start.schema.json#/$defs/output"
    },
    {
      "name": "resource_job_status",
      "description": "Read authoritative progress, terminal status, assets, and structured failures for a Job.",
      "side_effect": "none",
      "requires_flow_id": true,
      "idempotency_required": false,
      "input_schema": "schemas/tools/resource_job_status.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_job_status.schema.json#/$defs/output"
    },
    {
      "name": "resource_job_cancel",
      "description": "Request cancellation of a queued or running Job.",
      "side_effect": "job_control",
      "requires_flow_id": true,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_job_cancel.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_job_cancel.schema.json#/$defs/output"
    },
    {
      "name": "resource_archive",
      "description": "Archive one validated Asset produced by a succeeded Job without accepting a local path.",
      "side_effect": "archive_write",
      "requires_flow_id": true,
      "idempotency_required": true,
      "input_schema": "schemas/tools/resource_archive.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_archive.schema.json#/$defs/output"
    },
    {
      "name": "resource_library_search",
      "description": "Search archived Assets through bounded metadata filters and an opaque cursor.",
      "side_effect": "none",
      "requires_flow_id": true,
      "idempotency_required": false,
      "input_schema": "schemas/tools/resource_library_search.schema.json#/$defs/input",
      "output_schema": "schemas/tools/resource_library_search.schema.json#/$defs/output"
    }
  ]
}
