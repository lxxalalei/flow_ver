{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/session-manager/v1/schemas/tools/resource_session_status.schema.json",
  "title": "resource_session_status contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "platforms": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 64,
          "items": {
            "$ref": "../common.schema.json#/$defs/platform"
          }
        },
        "deep": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "session_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "label",
        "requires_login",
        "auth_kind",
        "login_url",
        "capture_method",
        "probe_supported",
        "status"
      ],
      "properties": {
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requires_login": {
          "type": "boolean"
        },
        "auth_kind": {
          "$ref": "../common.schema.json#/$defs/auth_kind"
        },
        "login_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "capture_method": {
          "$ref": "../common.schema.json#/$defs/capture_method"
        },
        "probe_supported": {
          "type": "boolean"
        },
        "cookie_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "storage_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "stored",
            "expired",
            "invalid",
            "missing",
            "not_required"
          ]
        },
        "captured_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "probe_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "no_probe",
            "probe_error",
            "missing",
            "not_required"
          ]
        },
        "probed_at": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "probe_detail": {
          "type": "string",
          "maxLength": 4096
        },
        "storage_key_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "login_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "label",
        "requires_login",
        "auth_kind",
        "login_url",
        "capture_method",
        "probe_supported"
      ],
      "properties": {
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requires_login": {
          "const": true
        },
        "auth_kind": {
          "type": "string",
          "enum": [
            "cookie",
            "token"
          ]
        },
        "login_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048
        },
        "capture_method": {
          "type": "string",
          "enum": [
            "browser_cookies",
            "browser_storage"
          ]
        },
        "probe_supported": {
          "type": "boolean"
        },
        "cookie_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "storage_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "storage_key_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "sessions",
        "needs_login"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session_entry"
          }
        },
        "needs_login": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/login_entry"
          }
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
