{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/session-manager/v1/schemas/tools/resource_session_login_guide.schema.json",
  "title": "resource_session_login_guide contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "platform"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "action",
        "actor",
        "requires_user_confirmation"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "action": {
          "type": "string",
          "enum": [
            "open_login_url",
            "user_login",
            "browser_cookies",
            "browser_storage",
            "resource_session_save",
            "resource_session_status"
          ]
        },
        "actor": {
          "type": "string",
          "enum": [
            "agent",
            "user"
          ]
        },
        "requires_user_confirmation": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "deep": {
          "type": "boolean"
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "platform",
        "label",
        "requires_login",
        "auth_kind",
        "login_url",
        "capture_method",
        "probe_supported",
        "steps"
      ],
      "properties": {
        "contract_version": {
          "$ref": "../common.schema.json#/$defs/contract_version"
        },
        "ok": {
          "const": true
        },
        "platform": {
          "$ref": "../common.schema.json#/$defs/platform"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requires_login": {
          "type": "boolean"
        },
        "auth_kind": {
          "$ref": "../common.schema.json#/$defs/auth_kind"
        },
        "login_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "capture_method": {
          "$ref": "../common.schema.json#/$defs/capture_method"
        },
        "probe_supported": {
          "type": "boolean"
        },
        "cookie_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "storage_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "security_notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "storage_key_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "../common.schema.json#/$defs/error_result"
        }
      ]
    }
  }
}
