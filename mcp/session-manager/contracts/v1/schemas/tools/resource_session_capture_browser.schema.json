{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/session-manager/v1/schemas/tools/resource_session_capture_browser.schema.json",
  "title": "resource_session_capture_browser contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "platform"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "platform": {"$ref": "../common.schema.json#/$defs/platform"},
        "idempotency_key": {
          "oneOf": [
            {"$ref": "../common.schema.json#/$defs/idempotency_key"},
            {"type": "null"}
          ]
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "ok",
        "platform",
        "status",
        "auth_kind",
        "session_revision",
        "captured_at",
        "stored_credential_count",
        "discarded_credential_count",
        "idempotent_replay",
        "captured_cookie_count"
      ],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "platform": {"$ref": "../common.schema.json#/$defs/platform"},
        "status": {"const": "stored"},
        "auth_kind": {"type": "string"},
        "session_revision": {"type": "string"},
        "captured_at": {"type": "string"},
        "stored_credential_count": {"type": "integer", "minimum": 0},
        "discarded_credential_count": {"type": "integer", "minimum": 0},
        "idempotent_replay": {"type": "boolean"},
        "captured_cookie_count": {"type": "integer", "minimum": 0},
        "expires_at": {
          "oneOf": [
            {"type": "string"},
            {"type": "null"}
          ]
        }
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
