{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanxiao.example/contracts/session-manager/v1/schemas/tools/resource_session_delete.schema.json",
  "title": "resource_session_delete contract v1",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/output"}
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "platform"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "platform": {"$ref": "../common.schema.json#/$defs/platform"},
        "idempotency_key": {
          "oneOf": [
            {"$ref": "../common.schema.json#/$defs/idempotency_key"},
            {"type": "null"}
          ]
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "ok", "platform", "deleted", "idempotent_replay"],
      "properties": {
        "contract_version": {"$ref": "../common.schema.json#/$defs/contract_version"},
        "ok": {"const": true},
        "platform": {"$ref": "../common.schema.json#/$defs/platform"},
        "deleted": {"type": "boolean"},
        "idempotent_replay": {"type": "boolean"}
      }
    },
    "output": {
      "oneOf": [
        {"$ref": "#/$defs/success"},
        {"$ref": "../common.schema.json#/$defs/error_result"}
      ]
    }
  }
}
