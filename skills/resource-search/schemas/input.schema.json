{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-input/v1",
  "title": "Validated intent input for search planning",
  "type": "object",
  "required": ["_meta", "data"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["schema_version", "session_id", "created_at"],
      "properties": {
        "schema_version": {"const": "intent-spec/v1"},
        "session_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["status", "slots", "constraints", "search_concepts"],
      "properties": {
        "status": {"const": "ready"},
        "slots": {"type": "object", "required": ["core_topic"]},
        "constraints": {"type": "object"},
        "search_concepts": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
