{
  "schema_version": "platform-search-registry/v1",
  "max_concurrency": 4,
  "platforms": {
    "generic": {"status": "available", "auth": "optional", "entry": "scripts/generic/adapter.py", "timeout_seconds": 30, "runtime": {"optional_auth_env": ["BAIDU_COOKIE", "BING_COOKIE"]}},
    "bilibili": {"status": "available", "auth": "optional", "entry": "scripts/bilibili/adapter.py", "timeout_seconds": 45, "runtime": {"optional_auth_env": ["BILIBILI_COOKIE", "BILIBILI_COOKIE_FILE"]}},
    "ximalaya": {"status": "available", "auth": "optional", "entry": "scripts/ximalaya/adapter.py", "timeout_seconds": 45, "runtime": {"optional_auth_env": ["XIMALAYA_COOKIE"]}},
    "smartedu": {"status": "available", "auth": "optional", "entry": "scripts/smartedu/adapter.py", "timeout_seconds": 90, "runtime": {"optional_auth_env": ["SMARTEDU_ACCESS_TOKEN", "SMARTEDU_COOKIE", "SMARTEDU_AUTHORIZATION", "SMARTEDU_HEADERS"]}},
    "zhihu": {"status": "available", "auth": "required", "entry": "scripts/zhihu/adapter.py", "timeout_seconds": 45, "runtime": {"auth_any_env": ["ZHIHU_COOKIE", "ZHIHU_COOKIE_FILE"]}},
    "douyin": {"status": "available", "auth": "required", "entry": "scripts/douyin/adapter.py", "timeout_seconds": 45, "runtime": {"python_all": ["f2"], "auth_any_env": ["DOUYIN_COOKIE", "DOUYIN_COOKIE_FILE"]}},
    "weibo": {"status": "available", "auth": "required", "entry": "scripts/weibo/adapter.py", "timeout_seconds": 60, "runtime": {"auth_any_env": ["WEIBO_COOKIE", "WEIBO_COOKIE_FILE"]}},
    "open163": {"status": "available", "auth": "optional", "entry": "scripts/open163/adapter.py", "timeout_seconds": 45, "runtime": {"optional_auth_env": ["OPEN163_COOKIE"]}},
    "annas-archive": {"status": "available", "auth": "none", "entry": "scripts/annas-archive/adapter.py", "timeout_seconds": 45, "runtime": {"optional_auth_env": ["ANNAS_BASE_URL"]}},
    "baiduwenku": {"status": "planned", "auth": "unknown", "entry": null},
    "cctv": {"status": "planned", "auth": "unknown", "entry": null}
  }
}
