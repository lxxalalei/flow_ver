{
  "description": "Selector 语义比较案例。预期只约束比较关系、排除决定和等级上限，不要求固定 quality_score。",
  "cases": [
    {
      "case_id": "official_low_popularity_vs_viral_shallow",
      "intent": "为 8 岁孩子找能真正理解火山形成过程的学习资料",
      "candidates": [
        {
          "resource_id": "museum:volcano-guide",
          "evidence": "自然博物馆公开页面，说明板块运动、岩浆上升和喷发过程，热度较低"
        },
        {
          "resource_id": "video:viral-eruption-clips",
          "evidence": "高播放量喷发合集，简介只有震撼画面和猎奇文案"
        }
      ],
      "expect": {
        "ordering": ["museum:volcano-guide > video:viral-eruption-clips"],
        "grade_ceiling": {
          "video:viral-eruption-clips": "B"
        },
        "notes": "热度不能替代主题解释和来源证据。"
      }
    },
    {
      "case_id": "title_only_vs_detailed_description",
      "intent": "找适合孩子入门古埃及的阅读资料",
      "candidates": [
        {
          "resource_id": "book:ancient-egypt-title-only",
          "evidence": "只有《儿童古埃及百科》标题和链接，作者、简介、目录均未知"
        },
        {
          "resource_id": "library:egypt-for-kids",
          "evidence": "图书馆页面提供作者、目录、内容简介和儿童馆藏分类"
        }
      ],
      "expect": {
        "ordering": ["library:egypt-for-kids > book:ancient-egypt-title-only"],
        "grade_ceiling": {
          "book:ancient-egypt-title-only": "B"
        },
        "notes": "只有标题与链接的候选不得进入 A 或 S。"
      }
    },
    {
      "case_id": "adult_documentary_vs_child_explainer",
      "intent": "为 7 岁孩子找二战历史启蒙视频",
      "candidates": [
        {
          "resource_id": "documentary:graphic-war-footage",
          "evidence": "成人纪录片，详情页说明含真实伤亡画面和集中营影像"
        },
        {
          "resource_id": "education:child-history-intro",
          "evidence": "儿童教育机构制作，用地图、时间线和非血腥插画讲解背景"
        }
      ],
      "expect": {
        "excluded": ["documentary:graphic-war-footage"],
        "notes": "主题相同不能抵消明确的适龄与安全冲突。"
      }
    },
    {
      "case_id": "near_duplicate_series",
      "intent": "找儿童天文入门课程",
      "candidates": [
        {
          "resource_id": "course:astronomy-complete",
          "evidence": "同一机构的完整 12 集系列，页面提供课程目录"
        },
        {
          "resource_id": "video:astronomy-episode-1",
          "evidence": "上述系列的第 1 集镜像，内容已被完整系列覆盖"
        },
        {
          "resource_id": "activity:night-sky-observation",
          "evidence": "配套夜空观察活动，内容形式与课程互补"
        }
      ],
      "expect": {
        "excluded": ["video:astronomy-episode-1"],
        "must_keep_together": ["course:astronomy-complete", "activity:night-sky-observation"],
        "notes": "确认是同一内容镜像时去重；互补媒介不作为重复项。"
      }
    },
    {
      "case_id": "unreachable_page",
      "intent": "找儿童编程 Scratch 入门教程",
      "candidates": [
        {
          "resource_id": "tutorial:scratch-unverified",
          "evidence": "搜索摘要看似相关，但详情页无法访问，作者和课程范围未知"
        },
        {
          "resource_id": "official:scratch-starter",
          "evidence": "公开可访问的官方入门教程，内容范围和操作步骤可核验"
        }
      ],
      "expect": {
        "ordering": ["official:scratch-starter > tutorial:scratch-unverified"],
        "grade_ceiling": {
          "tutorial:scratch-unverified": "B"
        },
        "required_notes": {
          "tutorial:scratch-unverified": ["页面未核验", "作者未知", "课程范围未知"]
        }
      }
    },
    {
      "case_id": "complementary_resource_set",
      "intent": "让 9 岁孩子理解植物如何生长，并能亲手观察",
      "candidates": [
        {
          "resource_id": "science:plant-explainer",
          "evidence": "可信科普机构的视频，解释萌发、光照和水分作用"
        },
        {
          "resource_id": "activity:seed-journal",
          "evidence": "适龄种子观察活动和记录模板，包含成人陪同提示"
        },
        {
          "resource_id": "quiz:plant-trivia",
          "evidence": "只有零散趣味问答，未覆盖生长过程"
        }
      ],
      "expect": {
        "ordering": ["science:plant-explainer > quiz:plant-trivia", "activity:seed-journal > quiz:plant-trivia"],
        "must_keep_together": ["science:plant-explainer", "activity:seed-journal"],
        "grade_ceiling": {
          "quiz:plant-trivia": "C"
        },
        "notes": "解释与实践形成互补组合，不要求所有高质量候选采用同一形态。"
      }
    },
    {
      "case_id": "safety_claim_requires_authority",
      "intent": "找儿童独自在家时应对火灾的安全学习资料",
      "candidates": [
        {
          "resource_id": "fire-service:home-safety",
          "evidence": "消防救援机构发布，包含报警、撤离和禁止行为说明"
        },
        {
          "resource_id": "blog:diy-fire-escape",
          "evidence": "匿名博客建议孩子尝试灭火，未提供专业来源或风险提示"
        }
      ],
      "expect": {
        "excluded": ["blog:diy-fire-escape"],
        "notes": "安全主题优先可核验的专业来源；危险建议直接过滤。"
      }
    },
    {
      "case_id": "publisher_reputation_not_enough",
      "intent": "找能帮助 10 岁孩子观察昆虫行为的资料",
      "candidates": [
        {
          "resource_id": "publisher:generic-insect-book",
          "evidence": "知名出版社页面，但只有宽泛书名，无简介、目录或适龄信息"
        },
        {
          "resource_id": "university:insect-observation-guide",
          "evidence": "大学推广机构发布，包含观察方法、记录问题和不伤害昆虫的提示"
        }
      ],
      "expect": {
        "ordering": ["university:insect-observation-guide > publisher:generic-insect-book"],
        "grade_ceiling": {
          "publisher:generic-insect-book": "B"
        },
        "notes": "机构名气不能自动证明内容相关、完整或适龄。"
      }
    }
  ]
