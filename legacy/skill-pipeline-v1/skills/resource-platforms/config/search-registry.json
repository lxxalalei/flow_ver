    "douyin": {"status": "available", "auth": "required", "entry": "scripts/douyin/adapter.py", "timeout_seconds": 45, "runtime": {"python_all": ["f2"], "auth_any_env": ["DOUYIN_COOKIE", "DOUYIN_COOKIE_FILE"]}},
    "weibo": {"status": "available", "auth": "required", "entry": "scripts/weibo/adapter.py", "timeout_seconds": 60, "runtime": {"auth_any_env": ["WEIBO_COOKIE", "WEIBO_COOKIE_FILE"]}},
