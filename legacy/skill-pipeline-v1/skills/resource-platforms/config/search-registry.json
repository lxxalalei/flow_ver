    "runoob": {"status": "available", "auth": "none", "entry": "scripts/runoob/adapter.py", "timeout_seconds": 45},
    "cctv": {"status": "available", "auth": "none", "entry": "scripts/cctv/adapter.py", "timeout_seconds": 45}
  }
